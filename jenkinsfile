pipeline {
    agent any

    environment {
        VM_IP   = '192.168.0.101'   // Apni CentOS VM ka IP yahan likhein
        VM_USER = 'centos'         // VM ka username
        SSH_KEY = 'centos-vm-ssh'  // Jenkins mein SSH Credential ki ID
    }

    stages {
        // Step 1: Code Pull Karna
        stage('1. Pull Code') {
            steps {
                echo 'GitHub se code fetch ho raha hai...'
                checkout scm
            }
        }

        // Step 2: Code VM Par Bhejna
        stage('2. Send Code to VM') {
            steps {
                echo 'Files CentOS VM par copy ho rahi hain...'
                sshagent([env.SSH_KEY]) {
                    // VM par folder banana aur files copy karna
                    sh "ssh -o StrictHostKeyChecking=no ${VM_USER}@${VM_IP} 'mkdir -p /home/${VM_USER}/app'"
                    sh "scp -r -o StrictHostKeyChecking=no ./* ${VM_USER}@${VM_IP}:/home/${VM_USER}/app/"
                }
            }
        }

        // Step 3: Containers Ko Run Karna
        stage('3. Run App on VM') {
            steps {
                echo 'Docker Containers restart ho rahe hain...'
                sshagent([env.SSH_KEY]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${VM_USER}@${VM_IP} '
                            cd /home/${VM_USER}/app
                            docker compose down
                            docker compose up --build -d
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Mubarakan! Website live ho gayi hai: http://${env.VM_IP}"
        }
        failure {
            echo "❌ Deployment mein error aaya hai."
        }
    }
}