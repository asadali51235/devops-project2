pipeline {
    agent any

    environment {
        VM_IP   = '192.168.0.100'   // CentOS VM IP
        VM_USER = 'centos'          // VM username
        SSH_KEY = 'centos-vm-ssh'  // Jenkins SSH Credential ID
    }

    stages {
        // Step 1: Code Pull Karna
        stage('1. Pull Code') {
            steps {
                echo 'GitHub se code fetch ho raha hai...'
                checkout scm
            }
        }

        // Step 2: Code Archive Karke VM Par Bhejna
        stage('2. Send Code to VM') {
            steps {
                echo 'Files compress karke CentOS VM par copy ho rahi hain...'
                sshagent([env.SSH_KEY]) {
                    sh """
                        # Local workspace par hidden files aur subfolders include karke archive banana
                        tar --exclude='.git' -czf app.tar.gz .

                        # VM par app folder create karna
                        ssh -o StrictHostKeyChecking=no ${VM_USER}@${VM_IP} "mkdir -p /home/${VM_USER}/app"

                        # Tar archive copy karna
                        scp -o StrictHostKeyChecking=no app.tar.gz ${VM_USER}@${VM_IP}:/home/${VM_USER}/app/

                        # VM par extract karna aur archive delete karna
                        ssh -o StrictHostKeyChecking=no ${VM_USER}@${VM_IP} "cd /home/${VM_USER}/app && tar -xzf app.tar.gz && rm app.tar.gz"

                        # Local Jenkins workspace ki temp tar file clean karna
                        rm -f app.tar.gz
                    """
                }
            }
        }

        // Step 3: Containers Ko Run Karna
        stage('3. Run App on VM') {
            steps {
                echo 'Docker Containers restart ho rahe hain...'
                sshagent([env.SSH_KEY]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${VM_USER}@${VM_IP} '
                            cd /home/${VM_USER}/app
                            docker compose down
                            docker compose up --build -d
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Mubarakan! Website live ho gayi hai: http://${env.VM_IP}"
        }
        failure {
            echo "❌ Deployment mein error aaya hai."
        }
    }
}